<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <NoWarn>$(NoWarn);1705;CS1705;NU1701;CA1416</NoWarn>
    <WarningsNotAsErrors>1705;CS1705</WarningsNotAsErrors>
    <RollForward>LatestMajor</RollForward>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <Target Name="OverrideCS1705" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <DisabledWarnings>$(DisabledWarnings);1705;CS1705</DisabledWarnings>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <Compile Remove="NetReload\obj\**;NetReload\bin\**" />
  </ItemGroup>

  <!-- ===== Thong tin phien ban: CHI SUA O DAY khi phat hanh ===== -->
  <PropertyGroup>
    <Version>1.4.0</Version>
    <Product>Civil Tool - NXSOFT</Product>
    <AssemblyTitle>Civil Tool - Bo cong cu tu dong hoa Civil 3D</AssemblyTitle>
    <Company>Huynh Ngoc Nam</Company>
    <Authors>Huynh Ngoc Nam</Authors>
    <Copyright>Copyright (c) Huynh Ngoc Nam</Copyright>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <Optimize>true</Optimize>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <PropertyGroup>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <AssemblyName>MyFirstProject</AssemblyName>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="Chuongmep.Civil3D.Api.accoremgd" Version="2025.0.0" />
    <PackageReference Include="Chuongmep.Civil3D.Api.acdbmgd" Version="2025.0.0" />
    <PackageReference Include="Chuongmep.Civil3D.Api.acmgd" Version="2025.0.0" />
    <PackageReference Include="Chuongmep.Civil3D.Api.AdWindows" Version="2025.0.0" />
    <PackageReference Include="Chuongmep.Civil3D.Api.AecBaseMgd" Version="2025.0.0" />
    <PackageReference Include="Chuongmep.Civil3D.Api.AeccDbMgd" Version="2025.0.0" />
    <PackageReference Include="Chuongmep.Civil3D.Api.AecPropDataMgd" Version="2025.0.0" />
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="ExcelNumberFormat" Version="1.1.0" />
    <PackageReference Include="SixLabors.Fonts" Version="1.0.1" />
    <PackageReference Include="RBush" Version="4.0.0" />
    <PackageReference Include="XstReader.Api" Version="1.0.6" />
  </ItemGroup>
</Project>
