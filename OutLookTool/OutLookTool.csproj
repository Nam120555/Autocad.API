<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>OutLookTool</AssemblyName>

    <!-- Build ra 1 file .exe duy nhất -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- Output vào C:\OutLook -->
    <OutputPath>bin\Release\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

    <!-- Icon & Info -->
    <Product>OutLook Email Filter and Export Tool</Product>
    <Company>NXSOFT</Company>
    <Version>1.0.0</Version>
    <Description>Phan mem doc, loc du lieu email Outlook va xuat Excel chuyen nghiep</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="XstReader.Api" Version="1.0.6" />
  </ItemGroup>

</Project>
