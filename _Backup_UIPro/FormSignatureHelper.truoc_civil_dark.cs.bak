using System;
using System.Drawing;
using System.Windows.Forms;

namespace MyFirstProject
{
    public static class FormSignatureHelper
    {
        private const string SignatureText = "DESIGNED BY HUYNH NGOC NAM / TRAFFIC ENGINEER  -  SĐT: 0378584154";

        public static void AddSignature(Form form)
        {
            form.Shown += (s, e) =>
            {
                // 1. Tăng chiều cao Form thêm 30px để có không gian chứa chữ ký
                form.Height += 30;
                if (form.MinimumSize.Height > 0)
                {
                    form.MinimumSize = new Size(form.MinimumSize.Width, form.MinimumSize.Height + 30);
                }

                // 2. Tạo Strip chứa chữ ký
                Panel strip = new Panel
                {
                    Dock = DockStyle.Bottom,
                    Height = 30,
                    BackColor = Color.FromArgb(240, 244, 248), // Màu xám nhạt/xanh nhạt đẹp mắt
                    Padding = new Padding(0)
                };

                // Vẽ viền mờ ở trên panel
                strip.Paint += (ps, pe) =>
                {
                    using (Pen p = new Pen(Color.FromArgb(200, 200, 200), 1))
                    {
                        pe.Graphics.DrawLine(p, 0, 0, strip.Width, 0);
                    }
                };

                // 3. Tạo Label chữ ký
                Label lbl = new Label
                {
                    Text = SignatureText,
                    ForeColor = Color.FromArgb(80, 80, 80), // Xám đậm thanh lịch
                    Font = new Font("Segoe UI", 8.5f, FontStyle.Italic | FontStyle.Bold),
                    AutoSize = true,
                    BackColor = Color.Transparent,
                    Cursor = Cursors.Default
                };

                strip.Controls.Add(lbl);
                form.Controls.Add(strip);

                // 4. SendToBack() đảm bảo panel này nằm sát mép viền nhất (WinForms Docking rule)
                strip.SendToBack();

                // 5. Căn giữa Label lúc hiển thị và khi resize
                Action centerLabel = () =>
                {
                    int x = (strip.ClientSize.Width - lbl.PreferredWidth) / 2;
                    int y = (strip.ClientSize.Height - lbl.PreferredHeight) / 2 + 1; // +1 để bù trừ viền
                    if (x < 5) x = 5;
                    lbl.Location = new Point(x, y);
                };

                centerLabel();
                strip.Resize += (rs, re) => centerLabel();
            };
        }
    }
}
